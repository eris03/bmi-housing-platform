{
  "name": "bmi-housing-platform",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @bmi/api --filter @bmi/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @bmi/api prisma:migrate:deploy",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "mobile:check": "cd apps/mobile && flutter analyze && dart format --output=none --set-exit-if-changed lib test && flutter test"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
