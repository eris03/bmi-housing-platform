# Copy to .env for local development. Never commit real values.

# --- Common ---
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata

# --- API ---
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://bmi:bmi@localhost:5432/bmi_platform?schema=public
LOG_LEVEL=info

# --- Auth (OIDC provider TBD) ---
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# --- Object storage (MinIO locally, S3-compatible in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=bmi-media-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- CRM (sandbox until real CRM is confirmed) ---
CRM_ADAPTER=sandbox
CRM_BASE_URL=
CRM_API_KEY=
CRM_WEBHOOK_SECRET=
CRM_SYNC_MAX_ATTEMPTS=8

# --- Firebase Cloud Messaging (server side only) ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON_BASE64=

# --- Rate limiting ---
RATE_LIMIT_ENQUIRY_PER_MINUTE=5

# --- Web (public values only; NEXT_PUBLIC_* are shipped to browsers) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ANDROID_APP_URL=
