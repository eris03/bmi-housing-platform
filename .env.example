# Copy to .env for local development. Never commit real values.
# The API validates these at startup (apps/api/src/config/env.ts) and exits with a clear message if any are wrong.

# --- API ---
NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://bmi:bmi@localhost:5432/bmi_platform?schema=public
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
READINESS_DB_TIMEOUT_MS=2000
# Only "sandbox" is accepted until the real CRM is documented (docs/crm-integration.md).
CRM_ADAPTER=sandbox

# --- Web (NEXT_PUBLIC_* values are shipped to browsers: no secrets) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mobile: passed at build time, not read from this file ---
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:4000/api/v1 --dart-define=APP_ENV=development

